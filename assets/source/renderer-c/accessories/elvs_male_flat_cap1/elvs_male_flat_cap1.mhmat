# Material definition for elv_checkerboardMaterial

name elv_checkerboardMaterial
description Elvs_male_flat_cap1 material
ambientColor 1.0 1.0 1.0
diffuseColor 0.1493 0.1437 0.1479
specularColor 0.5 0.5 0.5
shininess 0.0
emissiveColor 0.0 0.0 0.0
opacity 1.0
translucency 0.0

shadeless False
wireframe False
transparent False
alphaToCoverage True
backfaceCull False
depthless False

castShadows True

receiveShadows True

diffuseTexture blackwhitecloth.png

shader shaders/glsl/litsphere

shaderParam AdditiveShading -0.05
shaderParam litsphereTexture litspheres/lit_matte.png

shaderDefine CALC_NORMAL_Z

shaderConfig ambientOcclusion True
shaderConfig normal False
shaderConfig bump False
shaderConfig displacement False
shaderConfig vertexColors False
shaderConfig spec False
shaderConfig transparency True
shaderConfig diffuse True
