{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "game",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "game",
        "exec",
        "vite"
      ],
      "port": 5175,
      "autoPort": true
    },
    {
      "name": "game-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "game",
        "exec",
        "vite",
        "--",
        "preview",
        "game",
        "--outDir",
        "dist",
        "--port",
        "5225",
        "--strictPort"
      ],
      "port": 5225
    },
    {
      "name": "character-lab",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "lab",
        "--",
        "--port",
        "5199",
        "--strictPort"
      ],
      "port": 5199
    }
  ]
}
